    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-glitch",
    "iphone-duo",
    "foldable",
    "glitch",
    "green-line",
    "joke"
  ],
  "repository": "https://github.com/davidmokos/expo-glitch",
  "bugs": {
    "url": "https://github.com/davidmokos/expo-glitch/issues"
  },
  "author": "David Mokos <mokos@expo.dev>",
  "license": "MIT",
  "homepage": "https://github.com/davidmokos/expo-glitch#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native/jest-preset": "0.88.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.15",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^16.1.2",
    "expo": "^58.0.11",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.11",
    "prettier": "^3.0.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "files": [
    "build",
    "src",
    "ios",
    "android",
    "app.plugin.js",
    "expo-module.config.json",
    "README.md",
    "LICENSE"
